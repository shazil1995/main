# Copy to .env (docker-compose reads this automatically) and adjust as needed.
# Individual apps/packages also have their own .env.example for running
# outside Docker (apps/api/.env.example, apps/web/.env.local.example,
# packages/db/.env.example).

# --- Database ---
DATABASE_URL=postgresql://signage_crm:signage_crm_dev@localhost:5432/signage_crm?schema=public

# --- API ---
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# --- Redis (reserved for Phase 4 BullMQ workers; unused by Phase 1-2 code) ---
REDIS_URL=redis://localhost:6379

# --- Not yet used (Phase 3+); listed here so operators know what's coming ---
# AIRTABLE_ACCESS_TOKEN=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# ANTHROPIC_API_KEY=
