# Copy to .env and replace placeholders. Never commit real values.
# Owner connection: runs migrations and the narrow SECURITY DEFINER job functions only.
DATABASE_URL=postgres://basecraft_owner:CHANGE_ME_OWNER@localhost:5432/basecraft
# Application connection: non-owner role, row-level security ENFORCED.
APP_DATABASE_URL=postgres://basecraft_app:CHANGE_ME_APP@localhost:5432/basecraft
# Superuser DSN used ONLY by `npm run db:init` to create db/roles/extensions.
ADMIN_DATABASE_URL=postgres://postgres:CHANGE_ME_ADMIN@localhost:5432/postgres
BASECRAFT_OWNER_PASSWORD=CHANGE_ME_OWNER
BASECRAFT_APP_PASSWORD=CHANGE_ME_APP

PORT=4100
HOST=127.0.0.1
# Public origin of the web app (CORS allow-list + cookie Secure flag when https).
PUBLIC_ORIGIN=http://localhost:5173
# 64+ random hex chars. Used to HMAC cursors and signed values. Generate: openssl rand -hex 32
SERVER_SECRET=CHANGE_ME_64_HEX
# true = anyone can create an account (dev). Set false in production and use invitations.
ALLOW_SIGNUP=true
# inline = job worker runs inside the API process; separate = run `npm run worker`; off = disabled
WORKER_MODE=inline
WORKER_CONCURRENCY=2
ATTACHMENT_DIR=./data/attachments
MAX_ATTACHMENT_BYTES=10485760
WORKSPACE_ATTACHMENT_QUOTA_BYTES=524288000
MAX_EXPORT_ROWS=1000000
MAX_IMPORT_ROWS=200000
MAX_IMPORT_BYTES=52428800
DB_POOL_MAX=10
LOG_LEVEL=info
